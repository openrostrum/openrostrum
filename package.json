{
	"name": "openrostrum",
	"private": true,
	"description": "OpenRostrum — the open-source Sessionboard alternative.",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lefthook",
			"sharp",
			"workerd"
		]
	},
	"packageManager": "pnpm@10.20.0",
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply openrostrum --local",
		"db:migrate:remote": "wrangler d1 migrations apply openrostrum --remote",
		"db:seed": "wrangler d1 execute openrostrum --local --file=./drizzle/seed.sql",
		"db:reset": "rm -rf .wrangler/state && pnpm db:migrate && pnpm db:seed",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:css": "stylelint \"app/**/*.css\"",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"verify": "bash scripts/check-map.sh && pnpm typecheck && pnpm lint && pnpm lint:css && pnpm test",
		"postinstall": "wrangler types",
		"prepare": "lefthook install",
		"dev:worktree": "bash scripts/worktree-dev.sh",
		"typegen": "wrangler types && react-router typegen",
		"check": "tsc && react-router build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "react-router dev",
		"preview": "pnpm build && vite preview",
		"typecheck": "pnpm typegen && tsc -b"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@hookform/resolvers": "^5.7.1",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@tanstack/react-table": "^9.0.0",
		"@tiptap/pm": "^3.29.2",
		"@tiptap/react": "^3.29.2",
		"@tiptap/starter-kit": "^3.29.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.13.1",
		"ics": "^3.12.0",
		"isbot": "5.2.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "^7.85.0",
		"react-router": "8.3.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@cloudflare/vite-plugin": "1.51.0",
		"@cloudflare/vitest-pool-workers": "^0.20.3",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"@react-router/dev": "8.3.0",
		"@react-router/fs-routes": "8.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.1.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.9.0",
		"lefthook": "^2.1.10",
		"stylelint": "^17.14.1",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "^4.1.10",
		"wrangler": "4.119.0"
	},
	"cloudflare": {
		"label": "React Router Framework Starter",
		"products": [
			"Workers"
		],
		"categories": [
			"storage"
		],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/36a99c4a-8919-4e6e-ac9e-e55974407200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/65455e96-7992-425f-44e4-30f3e7d7f900/preview",
		"publish": true
	}
}
