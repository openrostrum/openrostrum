# Copy to `.deploy.env` (gitignored) to deploy your OWN instance. `pnpm deploy`
# (scripts/deploy.sh) injects these into the built worker config so the
# committed wrangler.json stays generic — no account-specific values in git.

# Required: your D1 database id (`wrangler d1 create openrostrum` prints it).
CF_D1_DATABASE_ID=

# Optional: override the committed defaults for your deployment.
# EMAIL_FROM=OpenRostrum <noreply@yourdomain.com>
# APP_ENV=production
