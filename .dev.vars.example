# Copy to `.dev.vars` for local development. `wrangler dev` / `react-router dev`
# merge these OVER wrangler.json vars, so local runs use the development env
# (APP_ENV=development → the local D1 `email_outbox` sink instead of Resend).
# Prod ships APP_ENV=production from wrangler.json and never reads this file.
APP_ENV=development

# Real email provider (Resend). Leave unset for local dev → mail goes to the
# readable `email_outbox` D1 sink instead of sending. Set BOTH to send for real:
#   RESEND_API_KEY — a Resend API key (send scope is enough)
#   EMAIL_FROM     — a sender on YOUR Resend-verified domain
# RESEND_API_KEY=re_...
# EMAIL_FROM=OpenRostrum <noreply@yourdomain.com>

# Airtable mirror (optional). Unset → in-memory local adapter (no network).
# AIRTABLE_API_KEY=pat...
# AIRTABLE_BASE_ID=app...

# Bot protection on the public CFP form. Unset → pass-through (so headless
# agents can submit). Set to enforce:
# TURNSTILE_SECRET=...
# TURNSTILE_SITE_KEY=...   # paired public widget key (both or neither)

# Public origin for links in CRON-sent emails (task-due reminders), where no
# request URL exists to derive it from. Request-driven emails always use the
# request origin. REQUIRED whenever RESEND_API_KEY is set (the reminder job
# fails loudly otherwise); optional locally — set it to your dev URL to get
# clickable portal links in the email_outbox sink.
# APP_ORIGIN=http://localhost:5200
